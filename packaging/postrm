#!/bin/sh
set -e

case "$1" in
    remove|purge)
        rm -f /etc/sudoers.d/wirezero /etc/sudoers.d/.wirezero.tmp
        rm -rf /usr/lib/wirezero/wirezero/__pycache__
        user="$(getent passwd 1000 | cut -d: -f1 || true)"
        if [ -n "$user" ] && getent group wirezero >/dev/null; then
            gpasswd -d "$user" wirezero >/dev/null 2>&1 || true
        fi
        ;;
esac
if [ "$1" = "purge" ] && getent group wirezero >/dev/null; then
    delgroup --system wirezero >/dev/null 2>&1 || groupdel wirezero >/dev/null 2>&1 || true
fi

exit 0
